# Apache Airflow Docker Compose Configuration
# Copy this file to .env.airflow and customize as needed
#
# Usage:
#   cp .env.airflow.example .env.airflow
#   # Edit .env.airflow with your values
#   docker-compose --env-file .env.airflow up -d

# =============================================================================
# Airflow Core Configuration
# =============================================================================

# Executor type: LocalExecutor for single-node, CeleryExecutor for distributed
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Fernet key for encrypting connection passwords (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Leave empty for development (no encryption)
AIRFLOW__CORE__FERNET_KEY=

# DAG behavior
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DEFAULT_TIMEZONE=UTC

# Parallelism settings
AIRFLOW__CORE__PARALLELISM=32
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1

# =============================================================================
# Webserver Configuration
# =============================================================================

AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8080
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__WEBSERVER__AUTHENTICATE=true
AIRFLOW__WEBSERVER__RBAC=true

# =============================================================================
# Scheduler Configuration
# =============================================================================

AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=300
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=false

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection (matches docker-compose.yaml)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_SIZE=10
AIRFLOW__DATABASE__SQL_ALCHEMY_MAX_OVERFLOW=20

# =============================================================================
# Pipeline Data Paths (mounted in container)
# =============================================================================

# Input/Output paths
AIRFLOW_DATA_RAW=/opt/airflow/data/raw
AIRFLOW_DATA_PROCESSED=/opt/airflow/data/processed
AIRFLOW_DATA_INTERMEDIATE=/opt/airflow/data/intermediate
AIRFLOW_DATA_CHECKPOINTS=/opt/airflow/data/checkpoints
AIRFLOW_CONFIG_PATH=/opt/airflow/config/pipeline_config.yaml

# =============================================================================
# Security - Change for production!
# =============================================================================

# Admin user credentials (only used during initial setup)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# =============================================================================
# Alerting Configuration (Optional)
# =============================================================================

# Email alerts
AIRFLOW_ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
AIRFLOW_ALERT_EMAIL_SMTP_PORT=587
AIRFLOW_ALERT_EMAIL_USERNAME=
AIRFLOW_ALERT_EMAIL_PASSWORD=
AIRFLOW_ALERT_EMAIL_FROM=
AIRFLOW_ALERT_EMAIL_TO=

# Webhook alerts (e.g., Slack)
AIRFLOW_ALERT_WEBHOOK_URL=

# =============================================================================
# Logging
# =============================================================================

AIRFLOW__LOGGING__BASE_LOG_FOLDER=/opt/airflow/logs
AIRFLOW__LOGGING__REMOTE_LOGGING=false
AIRFLOW__LOGGING__LOG_FORMAT=[%%(asctime)s] {{%%(filename)s:%%(lineno)d}} %%(levelname)s - %%(message)s

# =============================================================================
# Performance
# =============================================================================

# Worker settings (if using CeleryExecutor)
AIRFLOW__CELERY__WORKER_CONCURRENCY=4
AIRFLOW__CELERY__WORKER_AUTOSCALE=8,2

# =============================================================================
# Custom Pipeline Settings
# =============================================================================

# Pipeline-specific configuration
PIPELINE_ENVIRONMENT=development
PIPELINE_LOG_LEVEL=INFO

# Trust layer settings
TRUST_LAYER_ENABLED=true
LINEAGE_TRACKING_ENABLED=true
SLA_MONITORING_ENABLED=true
DRIFT_DETECTION_ENABLED=true